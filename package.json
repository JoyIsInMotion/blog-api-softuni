{
  "name": "blog-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:integration": "tsx --env-file=.env scripts/run-integration-tests.ts",
    "db:seed": "tsx --env-file=.env db/seed.ts",
