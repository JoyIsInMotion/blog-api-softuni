    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@neondatabase/serverless": "latest",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "drizzle-kit": "latest",
    "drizzle-orm": "latest",
    "jsonwebtoken": "^9.0.3",
    "neon": "^2.0.0",
    "next": "latest",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "jest": "^30.4.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "latest"
  }
